# Claude Video Editor settings.
# Copy this file to env.local, then edit env.local. Restart the server (node server.mjs) after any change.
# Every line is optional. Blank means "use the default". No quotes needed around values.
# env.local holds your keys: never share it, never commit it.

# ---------- the editor ----------

# Port the server listens on. Default 50002. You can also start it with: node server.mjs --port 50010
PORT=

# Where your projects live. Default: the projects folder next to server.mjs.
# A path relative to this folder, or a full path. tools/make-project.mjs writes new projects here too.
PROJECTS_DIR=

# Optional shared secret. When set, every /api call must send it in an x-rubric-token header.
# The pages the server serves pick it up by themselves, so the editor keeps working with no extra step.
RUBRIC_TOKEN=

# ---------- /cut transcription (pick one in skills/cut/settings.json, "transcriber") ----------

# AssemblyAI, the default: about 33 seconds to transcribe an hour of video.
# Get a key at https://www.assemblyai.com/dashboard (API Keys). Paid per hour of audio, check their pricing page.
ASSEMBLYAI_API_KEY=

# ElevenLabs Scribe: about the same speed, a bit more expensive. Worth it if you already pay for ElevenLabs.
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Whisper needs no key: it runs on your own computer for free, but takes 15 to 50 minutes per hour of video.

# ---------- FX and SFX lanes (Claude Video Editor addition) ----------

# The effects library the FX lane picks from, and the sound folder the SFX lane picks from.
# Default: the claude-video-effects repo cloned next to this folder (https://github.com/MonsterDylan/claude-video-effects)
# and its sounds/ folder. Full paths, no quotes.
FX_LIBRARY_DIR=
SFX_DIR=
